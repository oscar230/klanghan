# Required
ADMIN_PASSWORD=change-me

# Storage: "local" (files under DATA_DIR) or "s3". On AWS Lambda this defaults to s3.
STORAGE=local
DATA_DIR=data
# S3_BUCKET=my-klanghan-bucket

# Needed for `npm start` over plain http (adapter-node assumes https otherwise,
# which makes SvelteKit reject form posts). Not needed in `npm run dev`.
ORIGIN=http://localhost:3000
