# Required
ADMIN_PASSWORD=change-me

# Storage: "local" (files under DATA_DIR) or "s3". On AWS Lambda this defaults to s3.
STORAGE=local
DATA_DIR=data
# S3_BUCKET=my-klanghan-bucket

# Needed for `npm start` over plain http (adapter-node assumes https otherwise,
# which makes SvelteKit reject form posts). Not needed in `npm run dev`.
ORIGIN=http://localhost:3000

# Largest request body adapter-node accepts (default 512K). Photos are limited to 4 MB, and the form
# adds a little, so `npm start` needs this for the friendly "Bilden är för stor" message instead of a
# bare 413. The Dockerfile already sets it.
BODY_SIZE_LIMIT=5M
